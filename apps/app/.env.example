# apps/app (the Nexus) is a static export: every variable here is public
# (NEXT_PUBLIC_*) and ends up in the browser bundle. Secrets belong in
# apps/api, which the Nexus calls with the signed-in member's token.

# ── URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"

# ── Supabase (Settings → API Keys): the publishable key only ──────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Production: ".auibsal.org", so one sign-in covers every SAL host.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=""

# ── Observability (Sentry) ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only (source map upload on Vercel).
SENTRY_ORG=""
SENTRY_PROJECT=""

# Live presence and co-editing (Liveblocks; the secret stays in apps/api).
NEXT_PUBLIC_LIVEBLOCKS_ENABLED=""

# Phone notifications (Web Push). Public VAPID key; the private one is in
# apps/api only. Generate the pair with `bunx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
