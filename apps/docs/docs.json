{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "SAL Docs",
  "description": "The founding documents of the AUIB Society of Arts and Letters, the officer handbook for the Nexus, and how the platform runs.",
  "colors": {
    "primary": "#9c213e",
    "light": "#ebcbd3",
    "dark": "#7e1a32"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://auibsal.org"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Ubuntu"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#273236"
    }
  },
  "navbar": {
    "links": [{ "label": "auibsal.org", "href": "https://auibsal.org" }],
    "primary": {
      "type": "button",
      "label": "Open the Nexus",
      "href": "https://nexus.auibsal.org"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documents",
        "groups": [
          { "group": "Start here", "pages": ["index", "documents/overview"] },
          {
            "group": "Governance",
            "pages": [
              "documents/constitution",
              "documents/bylaws",
              "documents/roles-and-staffing",
              "documents/policy-manual",
              "documents/strategic-plan"
            ]
          },
          {
            "group": "Members",
            "pages": ["documents/member-handbook", "documents/glossary"]
          }
        ]
      },
      {
        "tab": "Officer handbook",
        "groups": [
          { "group": "Start here", "pages": ["introduction", "sign-in"] },
          {
            "group": "Running the Society",
            "pages": [
              "events",
              "journal",
              "content",
              "charity",
              "members",
              "settings"
            ]
          },
          { "group": "Making things", "pages": ["officers/brand"] }
        ]
      },
      {
        "tab": "Platform",
        "groups": [
          {
            "group": "The platform",
            "pages": [
              "platform/overview",
              "platform/accounts",
              "platform/api",
              "platform/notifications"
            ]
          },
          {
            "group": "Operations",
            "pages": [
              "platform/releases",
              "platform/backups",
              "platform/incidents"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "instagram": "https://www.instagram.com/auibsal",
      "github": "https://github.com/auibsal/mono"
    }
  },
  "search": { "prompt": "Search the documents and handbook" }
}
