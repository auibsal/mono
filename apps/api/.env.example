# apps/api: the only app with secrets. Deployed at api.auibsal.org.

# ── URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"

# ── Secrets (`openssl rand -hex 32` each) ──────────────────────────────────
# Vercel Cron sends CRON_SECRET as a Bearer token.
CRON_SECRET=""
# The Supabase database webhook on core.outbox sends this as a Bearer token.
DATABASE_WEBHOOK_SECRET=""
# Shared with apps/web's /api/revalidate route.
REVALIDATE_SECRET=""

# ── Notion (the team workspace) ────────────────────────────────────────────
# Notion → Settings → Connections → Develop or manage integrations → the
# "SAL Platform" connection (API token). Also allow it to read user
# information including email addresses. Empty: no Notion sync.
NOTION_TOKEN=""

# ── Supabase (Settings → API Keys) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Bypasses Row Level Security. apps/api and CI only — never web or app.
SUPABASE_SECRET_KEY=""

# ── Email (Resend, sending from auibsal.org) ───────────────────────────────
RESEND_FROM="SAL <hello@auibsal.org>"
RESEND_TOKEN=""

# ── Observability (Sentry) ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ── Security (Arcjet: shield, bots, rate limit, email checks) ──────────────
# Guards the public form endpoints. Unset in development: checks are skipped.
ARCJET_KEY=""


# Phone notifications (Web Push). `bunx web-push generate-vapid-keys` makes
# the pair: the public key also goes to the Nexus (sal-nexus), the private
# key stays here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
