{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "javascript": {
    "globals": []
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        // Inline handlers are idiomatic React; the re-render cost is negligible
        // and the React Compiler memoizes them where it matters.
        "noJsxPropsBind": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      // Generated by the shadcn CLI; updated with `bun run bump-ui`.
      "!packages/design-system/components/ui",
      "!packages/design-system/lib",
      "!packages/design-system/hooks",
      "!apps/email/.react-email",
      // The brand's own export and the source documents, kept as supplied.
      "!brand",
      "!docs-source",
      "!apps/web/public/brand",
      "!apps/app/public/brand",
      "!apps/web/app/icon.svg",
      "!apps/app/app/icon.svg",
      // Supabase Auth templates: Go template syntax, pasted into the dashboard.
      "!packages/database/supabase/templates",
      "!apps/e2e/test-results",
      "!apps/e2e/playwright-report"
    ]
  },
  "overrides": [
    {
      // Supabase Edge Functions run on Deno.
      "includes": ["packages/database/supabase/functions/**"],
      "javascript": { "globals": ["Deno"] }
    },
    {
      // Playwright journeys: inline URL and name patterns read best in place,
      // and steps run one after another on purpose.
      "includes": ["apps/e2e/**"],
      "linter": {
        "rules": {
          "performance": { "noAwaitInLoops": "off", "useTopLevelRegex": "off" }
        }
      }
    },
    {
      // Generated by `bun run db:types`: formatted, never linted.
      "includes": ["packages/database/types.ts"],
      "assist": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
